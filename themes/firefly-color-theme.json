    "property.readonly": "#d995b0",
    "enumMember": "#d995b0",
    "selfKeyword": { "foreground": "#ec5f57", "italic": true },
    "lifetime": { "foreground": "#e8a54b", "italic": true }
  },

  "tokenColors": [
    {
      "scope": ["meta.embedded", "source.groovy.embedded", "string meta.image.inline.markdown", "variable.legacy.builtin.python"],
      "settings": { "foreground": "#e8dccb" }
    },
    { "scope": "emphasis", "settings": { "fontStyle": "italic" } },
    { "scope": "strong", "settings": { "fontStyle": "bold" } },
    { "scope": "header", "settings": { "foreground": "#f39a4f" } },

    {
      "name": "Comments",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#8c7d6e", "fontStyle": "italic" }
    },
    {
      "name": "Doc comment tags",
      "scope": ["comment.block.documentation storage.type.class", "comment.block.documentation entity.name.type", "comment.block.documentation keyword.other", "comment.block.documentation variable", "storage.type.class.jsdoc", "punctuation.definition.block.tag.jsdoc"],
      "settings": { "foreground": "#b39a80", "fontStyle": "italic" }
    },

    {
      "name": "Keywords — control flow, declarations, storage, modifiers",
      "scope": [
        "keyword",
        "storage",
        "storage.type",
        "storage.modifier",
        "keyword.operator.noexcept",
        "keyword.other.fn",
        "keyword.function",
        "keyword.declaration",
        "keyword.other.class",
        "keyword.other.struct",
        "keyword.other.enum",
        "keyword.other.interface",
        "keyword.other.type",
        "keyword.other.var",
        "keyword.other.let",
        "keyword.other.const",
        "keyword.other.def",
        "storage.type.function",
        "storage.type.class",
        "storage.type.interface",
        "storage.type.enum",
        "storage.type.type",
        "storage.type.namespace",
        "storage.type.property",
        "keyword.control",
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.cast",
        "keyword.operator.sizeof",
        "keyword.operator.alignof",
        "keyword.operator.typeid",
        "keyword.operator.alignas",
        "keyword.operator.instanceof",
        "keyword.operator.logical.python",
        "keyword.operator.wordlike",
        "keyword.operator.delete",
        "keyword.other.operator",
        "entity.name.operator",
        "keyword.control.at-rule",
        "keyword.preprocessor",
        "keyword.control.import",
        "keyword.control.export",
        "keyword.control.from",
        "keyword.control.import.include",
        "keyword.operator.expression.import",
        "keyword.other.import",
        "keyword.other.package",
        "keyword.other.using",
        "keyword.other.directive.using",
        "keyword.import.go",
        "keyword.package.go",
        "keyword.other.rust",
        "keyword.other.unsafe.rust"
      ],
      "settings": { "foreground": "#ec5f57" }
    },
    {
      "name": "Builtin / primitive types (int, char, bool, ...) stay keyword red",
      "scope": [
        "storage.type.primitive",
        "storage.type.built-in",
        "storage.type.built-in.primitive",
        "support.type.primitive",
        "support.type.builtin",
        "keyword.type",
        "storage.type.primitive.java",
        "storage.type.primitive.array.java",
        "storage.type.primitive.groovy",
        "storage.type.primitive.array.groovy",
        "storage.type.primitive.go",
        "entity.name.type.primitive",
        "entity.name.type.numeric.rust",
        "entity.name.type.primitive.rust",
        "storage.type.numeric.go",
        "storage.type.byte.go",
        "storage.type.boolean.go",
        "storage.type.string.go",
        "storage.type.error.go",
        "storage.type.rune.go",
        "storage.type.uintptr.go"
      ],
      "settings": { "foreground": "#ec5f57" }
    },
