{
  "name": "firefly",
  "displayName": "Firefly",
  "description": "A warm theme in dark, night and light: red keywords, green strings, yellow types and orange functions.",
  "version": "0.9.1",
  "publisher": "LocalAlbino",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/LocalAlbino/firefly"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Themes"
  ],
  "contributes": {
    "themes": [
      {
        "label": "Firefly",
        "uiTheme": "vs-dark",
        "path": "./themes/firefly-color-theme.json"
      },
      {
        "label": "Firefly Night",
        "uiTheme": "vs-dark",
        "path": "./themes/firefly-night-color-theme.json"
      },
      {
        "label": "Firefly Light",
        "uiTheme": "vs",
        "path": "./themes/firefly-light-color-theme.json"
      }
    ]
  },
  "scripts": {
    "build": "node scripts/build-variants.js"
  }
}
